  "components": {
    "schemas": {
      "Ellipse": {
        "properties": {
          "cx": {
            "type": "number",
            "title": "Cx"
          },
          "cy": {
            "type": "number",
            "title": "Cy"
          },
          "a": {
            "type": "number",
            "title": "A"
          },
          "b": {
            "type": "number",
            "title": "B"
          },
          "angle_deg": {
            "type": "number",
            "title": "Angle Deg",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "cx",
          "cy",
          "a",
          "b"
        ],
        "title": "Ellipse"
      },
      "ExportSettings": {
        "properties": {
          "formats": {
            "items": {
              "type": "string",
              "enum": [
                "mp4",
                "webm",
                "gif"
              ]
            },
            "type": "array",
            "title": "Formats"
          },
          "size": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 64.0,
            "title": "Size",
            "default": 1080
          },
          "fps": {
            "type": "number",
            "maximum": 60.0,
            "exclusiveMinimum": 0.0,
            "title": "Fps",
            "default": 10.0
          },
          "keep": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Keep",
            "default": 1.0
          },
          "max_extent": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Extent",
            "default": 3.0
          },
          "grade": {
            "type": "boolean",
            "title": "Grade",
            "default": true
          }
        },
        "type": "object",
        "title": "ExportSettings"
      },
      "ExportStatus": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "done",
              "error"
            ],
            "title": "State",
            "default": "idle"
          },
          "log": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Log",
            "default": []
          },
          "outputs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Outputs",
            "default": []
          },
          "dropped": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dropped",
            "default": []
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "directory": {
            "type": "string",
            "title": "Directory",
            "default": ""
          }
        },
        "type": "object",
        "title": "ExportStatus"
      },
      "FitRequest": {
        "properties": {
          "points": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "points"
        ],
        "title": "FitRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "status": {
            "type": "string",
            "enum": [
              "unlabeled",
              "labeled",
              "no_ellipse",
              "skip"
            ],
            "title": "Status"
          },
          "n_ellipses": {
            "type": "integer",
            "title": "N Ellipses"
          },
          "prominent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ellipse"
              },
              {
                "type": "null"
              }
            ]
          },
          "predicted": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ellipse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "width",
          "height",
          "status",
          "n_ellipses",
          "prominent",
          "predicted"
        ],
        "title": "ImageInfo"
      },
      "ImageLabel": {
        "properties": {
          "ellipses": {
            "items": {
              "$ref": "#/components/schemas/ScoredEllipse"
            },
            "type": "array",
            "title": "Ellipses"
          },
          "prominent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prominent"
          },
          "status": {
            "type": "string",
            "enum": [
              "unlabeled",
              "labeled",
              "no_ellipse",
              "skip"
            ],
            "title": "Status",
            "default": "unlabeled"
          },
          "source": {
            "type": "string",
            "enum": [
              "human",
              "synth",
              "detector"
            ],
            "title": "Source",
            "default": "human"
          },
          "runtime_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime S"
          }
        },
        "type": "object",
        "title": "ImageLabel"
      },
      "PhotoInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "usable": {
            "type": "boolean",
            "title": "Usable"
          },
          "dropped": {
            "type": "boolean",
            "title": "Dropped"
          },
          "preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview"
          }
        },
        "type": "object",
        "required": [
          "name",
          "time",
          "usable",
          "dropped",
          "preview"
        ],
        "title": "PhotoInfo"
      },
      "ProjectInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Order"
          },
          "skipped": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skipped"
          },
          "settings": {
            "$ref": "#/components/schemas/ExportSettings"
          },
          "extent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extent"
          },
          "frames": {
            "type": "integer",
            "title": "Frames"
          },
          "photos": {
            "items": {
              "$ref": "#/components/schemas/PhotoInfo"
            },
            "type": "array",
            "title": "Photos"
          }
        },
        "type": "object",
        "required": [
          "name",
          "path",
          "order",
          "skipped",
          "settings",
          "extent",
          "frames",
          "photos"
        ],
        "title": "ProjectInfo"
      },
      "ProjectUpdate": {
        "properties": {
          "order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Order"
          },
          "skipped": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skipped"
          },
          "settings": {
            "$ref": "#/components/schemas/ExportSettings"
          }
        },
        "type": "object",
        "required": [
          "order",
          "skipped",
          "settings"
        ],
        "title": "ProjectUpdate"
      },
      "ScoredEllipse": {
        "properties": {
          "cx": {
            "type": "number",
            "title": "Cx"
          },
          "cy": {
            "type": "number",
            "title": "Cy"
          },
          "a": {
            "type": "number",
            "title": "A"
          },
          "b": {
            "type": "number",
            "title": "B"
          },
          "angle_deg": {
            "type": "number",
            "title": "Angle Deg",
            "default": 0.0
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "cx",
          "cy",
          "a",
          "b"
        ],
        "title": "ScoredEllipse"
      },
      "SortedOrder": {
        "properties": {
          "order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Order"
          }
        },
        "type": "object",
        "required": [
          "order"
        ],
        "title": "SortedOrder"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
