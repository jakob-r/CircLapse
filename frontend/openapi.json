    "/api/sorted": {
      "get": {
        "summary": "Sorted Order",
        "description": "The project order with the photos that have a circle arranged by similarity;\nthe others keep their relative order at the end. ``loop`` makes the last photo\nsimilar to the first, for videos that play in a loop.",
        "operationId": "sorted_order_api_sorted_get",
        "parameters": [
          {
            "name": "by",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "color",
                "geometry"
              ],
              "type": "string",
              "title": "By"
            }
          },
          {
            "name": "loop",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Loop"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortedOrder"
